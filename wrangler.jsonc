{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "failrouter",
  "compatibility_date": "2026-09-24",
  // Assets-only Worker: static files are served without running any code,
  // so requests don't count against the Workers free request quota.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Both hosts serve the site directly; pages declare canonical = apex.
  "routes": [
    { "pattern": "failrouter.com", "custom_domain": true },
    { "pattern": "www.failrouter.com", "custom_domain": true }
  ]
}
